# HTTPS in front of the Alibe web container (docker-compose.prod.yml, profile
# "https"). Domains come from DOMAINS in .env, e.g.
#   DOMAINS=alibe.online, www.alibe.online, beta.alibe.online
# Caddy gets and renews the certificates itself (Let's Encrypt).

{
	servers {
		# Cloudflare proxies every request (orange cloud). Trust only its edge
		# addresses, and take the visitor's real IP from CF-Connecting-IP, so
		# rate limits see people rather than Cloudflare.
		# Source: https://www.cloudflare.com/ips/
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

{$DOMAINS} {
	# The web container serves the app and proxies /api to the API replicas.
	# It listens on port 80 inside Docker (8081 is only its host mapping).
	reverse_proxy web:80 {
		# The visitor's IP, for the web container's nginx (real_ip) and the API.
		header_up X-Real-IP {client_ip}
	}
}
