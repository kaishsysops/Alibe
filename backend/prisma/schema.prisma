generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id       String     @id @default(cuid())
  name     String
  slug     String     @unique
  icon     String?
  parentId String?
  parent   Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children Category[] @relation("CategoryToCategory")
  listings Listing[]
}

model Atoll {
  id      String   @id @default(cuid())
  name    String
  code    String   @unique
  islands Island[]
}

model Island {
  id       String    @id @default(cuid())
  name     String
  atollId  String
  atoll    Atoll     @relation(fields: [atollId], references: [id])
  listings Listing[]
  users    User[]

  @@unique([atollId, name])
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
}

model User {
  id                     String         @id @default(cuid())
  // At least one of phone/email is always set: both are verified sign-in methods.
  phone                  String?        @unique
  name                   String
  username               String?        @unique
  email                  String?        @unique
  bio                    String?
  avatarColor            String?
  // Profile photo: a server path from /uploads. Initials on avatarColor when null.
  avatarUrl              String?
  // Category slugs picked in onboarding/profile; their rows lead Home.
  interests              String[]       @default([])
  islandId               String?
  island                 Island?        @relation(fields: [islandId], references: [id])
  paymentMethod          PaymentMethod?
  promoOptIn             Boolean        @default(true)
  showPhone              Boolean        @default(true)
  whatsappNumber         String?
  whatsappEnabled        Boolean        @default(false)
  viberNumber            String?
  viberEnabled           Boolean        @default(false)
  themeColor             String?
  verificationStatus     VerificationStatus @default(NONE)
  verifiedAt             DateTime?
  // Can review reports. Only set by prisma/make-admin.ts, never through the API.
  isAdmin                Boolean        @default(false)
  bannedAt               DateTime?
  // Not a person (the IBAY catalogue owner): no way to sign in, no public profile.
  isSystem               Boolean        @default(false)
  ibayItems              IbayItem[]
  adminCredential        AdminCredential?
  purchases              Purchase[]
  // Expo push tokens, one per signed-in device.
  pushTokens             String[]       @default([])
  reviewsWritten         Review[]       @relation("ReviewsWritten")
  reviewsReceived        Review[]       @relation("ReviewsReceived")
  reportsFiled           Report[]       @relation("ReportsFiled")
  reportsAgainst         Report[]       @relation("ReportsAgainst")
  blocking               Block[]        @relation("Blocking")
  blockedBy              Block[]        @relation("BlockedBy")
  savedSearches          SavedSearch[]
  offersMade             Offer[]        @relation("OffersMade")
  ordersBought           Order[]        @relation("OrdersBought")
  ordersSold             Order[]        @relation("OrdersSold")
  createdAt              DateTime       @default(now())
  listings               Listing[]
  favorites              Favorite[]
  messages               Message[]
  conversationsAsBuyer   Conversation[] @relation("BuyerConversations")
  conversationsAsSeller  Conversation[] @relation("SellerConversations")
  sessions               Session[]
  disputeEvidence        DisputeEvidence[]
}

enum Condition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
}

enum ListingStatus {
  ACTIVE
  RESERVED
  SOLD
  DRAFT
}

enum DeliveryOption {
  PICKUP
  FERRY
  COURIER
}

enum VerificationStatus {
  NONE
  VERIFIED
}

model Listing {
  id            String         @id @default(cuid())
  title         String
  description   String
  price         Int
  condition     Condition      @default(GOOD)
  status        ListingStatus  @default(ACTIVE)
  images        String[]
  deliveryOptions DeliveryOption[] @default([PICKUP])
  deliveryNote  String?
  categoryId    String
  category      Category       @relation(fields: [categoryId], references: [id])
  islandId      String
  island        Island         @relation(fields: [islandId], references: [id])
  sellerId      String
  seller        User           @relation(fields: [sellerId], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  // Client-generated key so a double-tapped "Publish" can't create two listings.
  clientRequestId String?      @unique
  // Off the marketplace: auto-hidden by reports, or removed by staff.
  hiddenAt      DateTime?
  // Set when the price comes down, for "was MVR X" and price drop alerts.
  previousPrice Int?
  priceDroppedAt DateTime?
  priceRaisedAt DateTime?
  imageHashes   ImageHash[]
  favoritedBy   Favorite[]
  conversations Conversation[]
  reviews       Review[]
  reports       Report[]
  offers        Offer[]
  orders        Order[]

  // Feed, chat and notification queries (added for load).
  @@index([status, hiddenAt, createdAt])
  @@index([categoryId, status, createdAt])
  @@index([sellerId, status])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id])
  createdAt DateTime @default(now())
  // The last price drop this person has already opened.
  priceSeenAt DateTime?

  @@unique([userId, listingId])
}

model Conversation {
  id        String    @id @default(cuid())
  listingId String
  listing   Listing   @relation(fields: [listingId], references: [id])
  buyerId   String
  buyer     User      @relation("BuyerConversations", fields: [buyerId], references: [id])
  sellerId  String
  seller    User      @relation("SellerConversations", fields: [sellerId], references: [id])
  messages  Message[]
  offers    Offer[]
  orders    Order[]
  buyerLastReadAt  DateTime?
  sellerLastReadAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([listingId, buyerId])

  // Feed, chat and notification queries (added for load).
  @@index([buyerId])
  @@index([sellerId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  text           String       @default("")
  // Optional attachment: a server path like /uploads/abc.jpg plus its kind.
  mediaUrl       String?
  mediaType      MediaType?
  // Client-generated key so retries/double-taps don't duplicate a message.
  clientId       String?      @unique
  offerId        String?      @unique
  offer          Offer?       @relation(fields: [offerId], references: [id])
  // Scam pattern spotted by src/safety.ts (PAY_FIRST, LINK, ...), if any.
  flag           String?
  createdAt      DateTime     @default(now())

  // Feed, chat and notification queries (added for load).
  @@index([conversationId, createdAt])
}

enum MediaType {
  IMAGE
  VIDEO
}

enum OfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  COUNTERED
  WITHDRAWN
}

model Offer {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  listingId      String
  listing        Listing      @relation(fields: [listingId], references: [id])
  fromId         String
  from           User         @relation("OffersMade", fields: [fromId], references: [id])
  amount         Int
  status         OfferStatus  @default(PENDING)
  clientId       String?      @unique
  message        Message?
  order          Order?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Feed, chat and notification queries (added for load).
  @@index([conversationId, status])
}

// A sale between one buyer and the seller. The seller is responsible for
// getting the item to the buyer; every delivery has to be verified by the
// buyer (handover code or "I received it"). Five verified deliveries make
// the seller a verified seller.
enum OrderStatus {
  AWAITING_DISPATCH
  DISPATCHED
  DELIVERED
  DISPUTED
  CANCELLED
}

model Order {
  id             String         @id @default(cuid())
  listingId      String
  listing        Listing        @relation(fields: [listingId], references: [id])
  conversationId String
  conversation   Conversation   @relation(fields: [conversationId], references: [id])
  buyerId        String
  buyer          User           @relation("OrdersBought", fields: [buyerId], references: [id])
  sellerId       String
  seller         User           @relation("OrdersSold", fields: [sellerId], references: [id])
  offerId        String?        @unique
  offer          Offer?         @relation(fields: [offerId], references: [id])
  amount         Int
  status         OrderStatus    @default(AWAITING_DISPATCH)
  deliveryMethod DeliveryOption?
  // Ferry shipments must name the boat so the buyer knows what to meet.
  boatName       String?
  boatDeparture  DateTime?
  cargoReference String?
  courierName    String?
  pickupNote     String?
  // Shown only to the buyer. The seller can only complete the delivery by
  // entering it, so the buyer releases it once the item is in their hands.
  handoverCode   String
  codeAttempts   Int            @default(0)
  dispatchedAt   DateTime?
  deliveredAt    DateTime?
  verifiedBy     String?
  problem        String?
  // Ferry shipments: photo of the cargo receipt, shown to the buyer.
  cargoReceiptUrl   String?
  // Disputes: both sides add evidence, staff decide (DELIVERED = seller keeps
  // the sale, CANCELLED = buyer is owed their money back).
  disputeOutcome    String?
  disputeNote       String?
  disputeResolvedAt DateTime?
  evidence          DisputeEvidence[]
  // Nudges sent to a seller who hasn't sent the item yet (see reminders.ts).
  remindersSent  Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Feed, chat and notification queries (added for load).
  @@index([sellerId, status])
  @@index([buyerId, status])
}

model Review {
  id         String   @id @default(cuid())
  sellerId   String
  seller     User     @relation("ReviewsReceived", fields: [sellerId], references: [id])
  reviewerId String
  reviewer   User     @relation("ReviewsWritten", fields: [reviewerId], references: [id])
  listingId  String
  listing    Listing  @relation(fields: [listingId], references: [id])
  rating     Int
  text       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // One review per buyer per item: a second submit edits it instead.
  @@unique([reviewerId, listingId])

  // Feed, chat and notification queries (added for load).
  @@index([sellerId])
}

enum ReportReason {
  SCAM
  PROHIBITED
  WRONG_CATEGORY
  OFFENSIVE
  OTHER
}

model Report {
  id             String       @id @default(cuid())
  reporterId     String
  reporter       User         @relation("ReportsFiled", fields: [reporterId], references: [id])
  listingId      String?
  listing        Listing?     @relation(fields: [listingId], references: [id])
  reportedUserId String?
  reportedUser   User?        @relation("ReportsAgainst", fields: [reportedUserId], references: [id])
  reason         ReportReason
  details        String?
  createdAt      DateTime     @default(now())
  resolvedAt     DateTime?

  // Reporting the same thing twice just updates the first report.
  @@unique([reporterId, listingId])
  @@unique([reporterId, reportedUserId])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("Blocking", fields: [blockerId], references: [id])
  blockedId String
  blocked   User     @relation("BlockedBy", fields: [blockedId], references: [id])
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
}

model SavedSearch {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  label         String
  // Normalised filter set (q, categorySlug, atollId, condition, minPrice,
  // maxPrice, delivery); paramsKey is its stable string form for dedupe.
  params        Json
  paramsKey     String
  lastSeenAt    DateTime @default(now())
  createdAt     DateTime @default(now())

  @@unique([userId, paramsKey])
}

// Password sign-in for staff only (see prisma/set-admin.ts). Separate from User
// because user rows are sent to the app, and a password hash must never be.
model AdminCredential {
  userId       String    @id
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  passwordHash String
  failures     Int       @default(0)
  lockedUntil  DateTime?
}

// Small server-side secrets that aren't tied to a user. Values are hashed.
model AppSetting {
  key   String @id
  value String
}

enum PurchaseKind {
  BOOST
  AD
  BUY_FOR_YOU
}

enum PurchaseStatus {
  REQUESTED        // Buy-for-you only: staff are checking the seller still has it.
  AWAITING_PAYMENT // Buyer can transfer the money now.
  SUBMITTED        // Slip uploaded, staff need to check the bank.
  ACTIVE           // Paid: boost or ad is running, or staff are buying the item.
  COMPLETED
  REJECTED
  CANCELLED
}

// Something bought from Alibe itself, paid by bank transfer. Alibe is the seller
// here, so this is separate from Order, which is between two users.
model Purchase {
  id              String         @id @default(cuid())
  kind            PurchaseKind
  status          PurchaseStatus
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount          Int
  // Typed into the transfer so staff can match it to this purchase.
  reference       String         @unique
  slipUrl         String?
  note            String?
  // Stops a double tap from creating two.
  clientRequestId String         @unique
  days            Int?
  startsAt        DateTime?
  endsAt          DateTime?
  listingId       String?
  adTitle         String?
  adImage         String?
  adUrl           String?
  impressions     Int            @default(0)
  clicks          Int            @default(0)
  ibayItemId      String?
  itemTitle       String?
  itemUrl         String?
  itemPrice       Int?
  deliveryNote    String?
  contactPhone    String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status])
  @@index([kind, status, endsAt])
}

// An item copied from ibay.com.mv for staff to follow up on by hand (see
// prisma/import-ibay.ts). A separate table, not Listing, so no public query can
// ever return one. Only /admin/ibay reads it.
model IbayItem {
  id         String   @id
  title      String
  url        String
  imageUrl   String?
  price      Int?
  currency   String?
  condition  String?
  category   String
  ownerId    String
  owner      User     @relation(fields: [ownerId], references: [id])
  firstSeenAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  // Alibe's category slug and condition for this item (see src/ibayCategories.ts).
  alibeCategory String?
  conditionKey Condition?
  // Read from the item's own page the first time someone opens it.
  description String?
  images     String[] @default([])
  phone      String?
  whatsapp   String?
  lastUpdated String?
  detailsFetchedAt DateTime?
  // Out of the public showcase: reported, hidden by staff, or removed by its seller.
  hiddenAt   DateTime?
  // The seller moved it to their own Alibe listing.
  claimedListingId String?
  reports    IbayReport[]

  @@index([lastSeenAt])
  @@index([alibeCategory])
}

model IbayReport {
  itemId    String
  item      IbayItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@id([itemId, userId])
}

// A phone or email that can't sign in or be added to any account. Kept apart
// from User so a ban outlives the account.
model BannedContact {
  value     String   @id
  createdAt DateTime @default(now())
}

// A one-time sign-in code waiting to be used (see src/otp.ts). `key` says what
// it's for and who it went to; only a hash of the code is stored.
model LoginCode {
  key         String   @id
  codeHash    String
  expiresAt   DateTime
  attempts    Int      @default(0)
  sentAt      DateTime
  sendCount   Int      @default(1)
  windowStart DateTime
}

// A signed-in device. Only a hash of the token is stored (see src/auth.ts).
model Session {
  tokenHash  String   @id
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([userId])
}

// What each side says (and shows) about a disputed order.
model DisputeEvidence {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  photoUrl  String?
  createdAt DateTime @default(now())

  @@index([orderId])
}

// A 64-bit fingerprint (difference hash) of each listing photo. Near-identical
// photos have fingerprints a few bits apart, so a listing reusing someone
// else's photos is spotted and sent to staff.
model ImageHash {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  sellerId  String
  imageUrl  String
  hash      BigInt
  createdAt DateTime @default(now())

  @@unique([listingId, imageUrl])
  @@index([sellerId])
}
