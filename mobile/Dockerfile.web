# Static web build of the app, served by nginx. The API address is baked in at
# build time, so this image is rebuilt whenever API_URL changes.
FROM node:22-bookworm AS build
WORKDIR /app
COPY package.json ./
RUN npm install
COPY . .
ARG API_URL
ENV EXPO_PUBLIC_API_BASE_URL=$API_URL
RUN test -n "$API_URL" && npx expo export --platform web --output-dir dist

FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
