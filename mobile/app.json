{
  "expo": {
    "name": "Alibe",
    "slug": "alibe",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#FF6A00"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.alibe.app"
    },
    "android": {
      "package": "com.alibe.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Alibe uses your photos so you can add listing images."
        }
      ],
      "expo-status-bar",
      "expo-video",
      "expo-image"
    ]
  }
}
